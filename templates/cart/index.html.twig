{% extends 'base.html.twig' %}

{% block title %}Shopping Cart - Ecommerce{% endblock %}

{% block body %}
<div class="container">
    <h1 class="mb-4">🛒 Shopping Cart</h1>

    {% if items is empty %}
        <div class="alert alert-info text-center" role="alert">
            <h4 class="alert-heading">Your cart is empty</h4>
            <p>Start shopping to add products to your cart.</p>
            <hr>
            <a href="{{ path('product_list') }}" class="btn btn-primary">
                ← Continue Shopping
            </a>
        </div>
    {% else %}
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product_id, item in items %}
                            <tr>
                                <td>
                                    <a href="{{ path('product_show', {'id': item.product.id}) }}" class="text-decoration-none">
                                        {{ item.product.name }}
                                    </a>
                                    <br>
                                    <small class="text-muted">{{ item.product.category }}</small>
                                </td>
                                <td>
                                    <form method="POST" action="{{ path('cart_update', {'id': product_id}) }}" class="d-flex gap-2 justify-content-center align-items-center">
                                        <input type="number" name="quantity" value="{{ item.quantity }}" min="1" class="form-control" style="width: 70px;">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">↻</button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    {{ item.product.price }} TND
                                </td>
                                <td class="text-end font-weight-bold">
                                    <strong>{{ (item.product.price * item.quantity)|number_format(2) }} TND</strong>
                                </td>
                                <td class="text-center">
                                    <form method="POST" action="{{ path('cart_remove', {'id': product_id}) }}" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Remove from cart">
                                            🗑️
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="text-start">
                    <a href="{{ path('product_list') }}" class="btn btn-outline-secondary">
                        ← Continue Shopping
                    </a>
                    <form method="POST" action="{{ path('cart_clear') }}" style="display: inline;">
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Clear your entire cart?')">
                            Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-body">
                        <h5 class="card-title">Order Summary</h5>
                        <hr>
                        
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal ({{ total_items }} items):</span>
                            <strong>{{ subtotal|number_format(2) }} TND</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Shipping:</span>
                            <strong class="text-success">FREE</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax:</span>
                            <strong>{{ (subtotal * 0.20)|number_format(2) }} TND</strong>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between mb-4">
                            <h5>Total:</h5>
                            <h5 class="text-success">{{ (subtotal * 1.20)|number_format(2) }} TND</h5>
                        </div>

                        <button type="button" class="btn btn-success btn-lg w-100" disabled>
                            💳 Proceed to Checkout (Coming Soon)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
