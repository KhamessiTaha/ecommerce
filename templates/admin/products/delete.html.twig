{% extends 'base.html.twig' %}

{% block title %}Delete Product{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-md-center">
        <div class="col-md-6">
            <div class="alert alert-danger">
                <h1 class="alert-heading">⚠️ Delete Product</h1>
                <p>Are you sure you want to delete this product?</p>
                <hr>
                <p class="mb-0">
                    <strong>{{ product.name }}</strong> - {{ product.price }} TND
                </p>
            </div>

            <form method="POST" class="d-grid gap-2">
                <button type="submit" class="btn btn-danger btn-lg">
                    🗑️ Yes, Delete This Product
                </button>
                <a href="{{ path('admin_products_list') }}" class="btn btn-secondary btn-lg">Cancel</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}
