{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Saroukh TN{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <a href="{{ path('product_list') }}" class="btn btn-light">
                ← Back to Products
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                <span style="font-size: 6rem;">📦</span>
            </div>
        </div>
        <div class="col-md-6">
            <h1 class="mb-3">{{ product.name }}</h1>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Product Details</h5>
                    
                    <div class="mb-3">
                        <h6 class="text-muted">Product ID</h6>
                        <p>{{ product.id }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Category</h6>
                        <p class="badge bg-info text-dark">{{ product.category }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Description</h6>
                        <p>{{ product.description }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Price</h6>
                        <h3 class="text-success">{{ product.price }} TND</h3>
                    </div>

                    <form method="POST" action="{{ path('cart_add', {'id': product.id}) }}" class="mb-3">
                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantity</label>
                            <input type="number" id="quantity" name="quantity" value="1" min="1" max="99" class="form-control" style="max-width: 100px;">
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                🛒 Add to Cart
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Recommendations Section -->
    {% if recommendations is not empty %}
    <div class="row mt-5 mb-4">
        <div class="col-md-12">
            <h2 class="mb-4">⭐ Recommended For You</h2>
            <p class="text-muted mb-4">Similar products in {{ product.category }} category</p>
        </div>
    </div>

    <div class="row">
        {% for rec_product in recommendations %}
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-info">
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                    <span style="font-size: 4rem;">📦</span>
                </div>
                <div class="card-body">
                    <h5 class="card-title">{{ rec_product.name }}</h5>
                    <p class="card-text text-muted">{{ rec_product.category }}</p>
                    <p class="card-text">
                        {% if rec_product.description|length > 100 %}
                            {{ rec_product.description|slice(0, 100) ~ '...' }}
                        {% else %}
                            {{ rec_product.description }}
                        {% endif %}
                    </p>
                    <h6 class="card-subtitle mb-2 text-success">{{ rec_product.price }} TND</h6>
                </div>
                <div class="card-footer bg-white border-top d-flex gap-2">
                    <a href="{{ path('product_show', {'id': rec_product.id}) }}" class="btn btn-primary btn-sm flex-grow-1">
                        👁️ View
                    </a>
                    <form method="POST" action="{{ path('cart_add', {'id': rec_product.id}) }}" style="flex-grow: 1;">
                        <button type="submit" class="btn btn-success btn-sm w-100">
                            🛒 Add
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endblock %}